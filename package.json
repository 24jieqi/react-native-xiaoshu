{
  "name": "@fruits-chain/react-native-xiaoshu",
  "description": "🌈 React Native UI library",
  "version": "0.4.8",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/**.md"
  ],
  "keywords": [
    "react-native",
    "ui-components",
    "typescript"
  ],
  "license": "Apache-2.0",
  "homepage": "https://24jieqi.github.io/react-native-xiaoshu",
  "repository": {
    "type": "git",
    "url": "https://github.com/24jieqi/react-native-xiaoshu"
  },
  "bugs": {
    "url": "https://github.com/24jieqi/react-native-xiaoshu/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "jest --update-snapshot --detectOpenHandles",
    "test:s": "jest ./src/bottom-bar/__tests__ -u --update-snapshot --detectOpenHandles --coverage",
    "test:coverage": "jest --coverage",
    "test:clear": "jest --clearCache",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:example": "eslint example --ext .js,.jsx,.ts,.tsx",
    "commit": "npx git-cz",
    "ncu": "npx npm-check-updates -u -x react,react-native,react-is,@types/react-is,react-native-svg,@react-native/babel-preset,react-test-renderer,@types/react-test-renderer,color,typescript",
    "lint:ts": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "prettier": "prettier --write '{src,demo}/**/*.{js,json,yml,yaml,ts,tsx,md}'",
    "lint-staged": "lint-staged --allow-empty",
    "doc": "dumi dev",
    "doc:github-build": "cross-env PUBLIC_PATH=react-native-xiaoshu/ dumi build",
    "prepare": "husky install && dumi setup",
    "build": "bob build",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta",
    "release:major": "release-it major",
    "release:minor": "release-it minor",
    "release:patch": "release-it patch",
    "release:major:beta": "release-it major --preRelease=beta",
    "release:minor:beta": "release-it minor --preRelease=beta",
    "release:patch:beta": "release-it patch --preRelease=beta",
    "run:publish": "node ./scripts/publish.js"
  },
  "dependencies": {
    "@fruits-chain/design-tokens-bailu": "^0.1.0",
    "@fruits-chain/icons-react-native": "^0.1.14",
    "color": "^3.2.1",
    "fast-deep-equal": "^3.1.3",
    "lodash": "^4.17.21",
    "react-is": "^18.0.0",
    "react-native-popover-view": "^6.1.0",
    "rn-placeholder": "^3.0.3"
  },
  "peerDependencies": {
    "rc-field-form": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/compat": "^1.4.0",
    "@react-native/babel-preset": "0.81.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/color": "^4.2.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/react-is": "^18.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^30.1.2",
    "core-js": "^3.45.1",
    "cross-env": "^10.0.0",
    "dumi": "~2.4.21",
    "dumi-theme-mobile": "^2.3.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.10.0",
    "expo-dev-menu": "^7.0.12",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.2.1",
    "prettier": "^3.6.2",
    "rc-field-form": "^2.7.0",
    "react": "18.3.1",
    "react-native": "0.81.4",
    "react-native-builder-bob": "0.40.13",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.1",
    "react-test-renderer": "19.0.0",
    "release-it": "^19.0.5",
    "ts-jest": "^29.4.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "resolutions": {
    "@types/react": "~19.1.10",
    "prettier": "^3.2.0"
  },
  "lint-staged": {
    "*.{yml,yaml,md}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "bash -c tsc --noEmit",
      "eslint --fix",
      "prettier --write"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": false,
        "ignoreRecommendedBump": true
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
